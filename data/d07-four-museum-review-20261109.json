  "schedule": [
    {
      "time": "10:00–11:00",
      "place": "sewer",
      "activity": "下水道博物馆，1小时；按10点开放开始。"
    },
    {
      "time": "11:00–11:40",
      "activity": "至罗丹并入场，保留原40分钟缓冲。"
    },
    {
      "time": "11:40–13:10",
      "place": "rodin",
      "activity": "罗丹与花园，90分钟；花园安排在白天。"
    },
    {
      "time": "13:10–14:10",
      "activity": "午餐1小时，餐厅待选。"
    },
    {
      "time": "14:10–15:00",
      "activity": "罗丹至邮政馆，路网约2.07公里／31分钟；合计留50分钟，含步行或短程交通、进出与安检。"
    },
    {
      "time": "15:00–16:15",
      "place": "post",
      "activity": "邮政博物馆75分钟，早于17:15最后入场及18:00闭馆。"
    },
    {
      "time": "16:15–17:00",
      "activity": "赴荣军院129 rue de Grenelle夜场入口，步行路网约2.33公里／35分钟；留45分钟，可改短程公共交通。"
    },
    {
      "time": "17:00–18:00",
      "activity": "荣军院附近晚餐1小时；夜场票的入场与安检提前要求另核，餐厅需邻近入口。"
    },
    {
      "time": "18:00–21:00",
      "place": "invalides",
      "activity": "荣军院夜场3小时，陵墓与军事博物馆主馆优先；以当晚实际开放和票务为准。"
    },
    {
      "time": "21:00后",
      "activity": "结束返程；本方案不再额外安排一段克莱尔街购物。"
    }
  ],
